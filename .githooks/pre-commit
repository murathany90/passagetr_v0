#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
  runner=(pwsh -NoProfile -ExecutionPolicy Bypass)
elif command -v powershell >/dev/null 2>&1; then
  runner=(powershell -NoProfile -ExecutionPolicy Bypass)
else
  echo "UTF-8 pre-commit check skipped: neither pwsh nor powershell was found." >&2
  exit 1
fi

"${runner[@]}" -File "$repo_root/scripts/ensure_utf8.ps1" -StagedOnly
